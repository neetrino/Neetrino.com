
# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL=""
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"


# Admin authentication
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Arca payments
ARCA_TEST_MODE="true"
ARCA_BANK="idbank"
ARCA_USERNAME=""
ARCA_PASSWORD=""
ARCA_LIVE_USERNAME=""
ARCA_LIVE_PASSWORD=""

# ——— Cache (Upstash Redis) ———
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN=""


# ——— Email (Resend) ———
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="test@neetrino.com"

# ——— File storage (Cloudflare R2) ———
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Server-side R2 URL (admin uploads, next.config remotePatterns). Required at Vercel build time.
R2_PUBLIC_URL=""
# Browser CDN base for static assets (defaults to R2_PUBLIC_URL at build time if unset)
NEXT_PUBLIC_R2_PUBLIC_URL=""
# Admin portfolio uploads PUT directly to R2. Run `pnpm r2:cors` once so the
# bucket allows browser PUT from https://www.neetrino.com (OPTIONS 403 otherwise).

# ——— Figma (MCP) ———
FIGMA_ACCESS_TOKEN=""

# ——— Telegram notifications ———
# Set true only after the bot token and at least one chat ID are configured.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs (private users and/or groups/supergroups). Example: 7910562238,-1001234567890
TELEGRAM_CHAT_IDS=
# Admin base URL used by the Open Message button (example: https://example.com/admin)
ADMIN_APP_URL=

# Machine API for blog publishing. Min 32 characters. Send as X-API-Key.
# POST /api/v1/auth/token → bearer token, then POST /api/v1/blog with both headers.
API_KEY=""